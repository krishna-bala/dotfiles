#!/bin/bash

# ======================
# >>> misc functions <<<
# ======================
rg() {
  command rg -p "$@" | less -RFX
}
# >>> misc functions end

# ============
# >>> tmux <<<
# ============
tmat() {
  if [ "$#" -eq 1 ]; then
    tmux a -t "$1"
  else
    echo "Usage: tmat <session-name>"
  fi
}

tmns() {
  if [ "$#" -eq 1 ]; then
    tmux new -s "$1"
  else
    echo "Usage: tmns <session-name>"
  fi
}

tmks() {
  if [ "$#" -eq 1 ]; then
    tmux kill-session -t "$1"
  else
    tmux kill-server
  fi
}

tmls() {
  tmux ls
}
# >>> tmux end

# ===========
# >>> git <<<

lg() {
  lazygit
}

# >>> git end

# ===============
# >>> kittens <<<
# ===============
kssh() {
  kitty +kitten ssh "$@"
}
# Complete kssh exactly like ssh: bash-completion's ssh completer reads
# ~/.ssh/config (Includes too), known_hosts, and is case-insensitive about
# keywords. Its function name differs between bash-completion versions, so
# copy whatever spec ssh has. No-op without bash-completion.
_completion_loader ssh 2>/dev/null
eval "$(complete -p ssh 2>/dev/null | sed 's/ ssh$/ kssh/')"
# ===============

# Machine-local shell env (untracked; e.g. work-specific vars). No-op if absent.
[ -f "$HOME/.bash_aliases.local" ] && . "$HOME/.bash_aliases.local"
