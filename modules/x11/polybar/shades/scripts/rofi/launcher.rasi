/* Shared by the application launcher and Alt+Tab window switcher.
 * Tokyo Night Storm surfaces with the desktop's focused-border blue.
 * Inter and Papirus are already used on this desktop.
 */
configuration {
    font: "Inter 18";
    show-icons: true;
    icon-theme: "Papirus";
    display-drun: "";
    display-window: "";
    drun-display-format: "{name}";
    disable-history: false;
    fullscreen: false;
    hide-scrollbar: true;
    sidebar-mode: false;
    // Rofi grabs the keyboard, so sxhkd cannot handle screenshots here.
    kb-screenshot: "Super+p,Super+Print,Alt+s";
}

* {
    background-color: transparent;
    text-color: #c0caf5;
    border-color: #629dc8;
}

window {
    transparency: "real";
    background-color: #24283b;
    border: 2px;
    border-radius: 24px;
    width: 860px;
    location: center;
    anchor: center;
    x-offset: 0;
    y-offset: 0;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
    padding: 24px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: #1f2335;
    border-radius: 12px;
    padding: 18px 20px;
    spacing: 12px;
}

prompt {
    font: "JetBrainsMono Nerd Font Mono 20";
    padding: 0px 6px;
    text-color: #629dc8;
    vertical-align: 0.5;
}

entry {
    font: "Inter 20";
    placeholder: "Search…";
    placeholder-color: #9aa5ce;
    text-color: #c0caf5;
    expand: true;
    blink: true;
}

listview {
    columns: 1;
    lines: 7;
    spacing: 4px;
    cycle: true;
    dynamic: false;
    fixed-height: true;
    layout: vertical;
    scrollbar: false;
}

element {
    orientation: horizontal;
    padding: 14px 16px;
    spacing: 18px;
    border-radius: 10px;
}

element-icon {
    size: 36px;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    expand: true;
    vertical-align: 0.5;
}

element selected.normal, element selected.active {
    background-color: #629dc8;
    text-color: #1f2335;
}

element normal.active {
    text-color: #7dcfff;
}

element normal.urgent, element selected.urgent {
    background-color: #f7768e;
    text-color: #1f2335;
}
