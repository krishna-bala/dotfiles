#########################
## bspwm/sxhkd hotkeys ##
#########################

# Each binding's comment is read by the hotkey cheatsheet (super+slash):
# its first line is the short description shown there, and any further
# lines are detail kept only in this file.

# quit bspwm
super + alt + q
	bspc quit

# re-detect monitors and apply profile
# re-detects the topology, then applies the best-matching monitor profile
super + alt + r
	~/.config/bspwm/scripts/apply-auto.sh

# restart bspwm in place (emergency)
# rarely needed; topology changes go through super+alt+r
super + alt + ctrl + r
	bspc wm -r

# reload sxhkd config
super + Escape
	pkill -USR1 -x sxhkd

#####################
## Node Management ##
#####################

# close / kill window
super + {_,shift + }w
	bspc node -{c,k}

# toggle tiled / monocle layout
super + m
	bspc desktop -l next

# tiled / pseudo-tiled / floating / fullscreen
super + {t,shift + t,s,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# set the node flags
# super + shift + {m,x,y,z}
# 	bspc node -g {marked,locked,sticky,private}

# toggle sticky window
# a sticky window stays visible on every desktop
super + shift + y
	bspc node -g sticky

