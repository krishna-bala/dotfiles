# # send the newest marked node to the newest preselected node
# super + y
# 	bspc node newest.marked.local -n newest.!automatic.local
#
# # swap the current node and the biggest window
# super + g
# 	bspc node -s biggest.window

###############################
## Node & Desktop focus/swap ##
###############################

# focus window in direction
# falls through to the next monitor when there is no window that way
super + {h,j,k,l}
  ~/.config/bspwm/scripts/smart_focus.sh {west,south,north,east}

# move window in direction
# swaps with the neighbour, or moves to the next monitor at the edge
super + shift + {h,j,k,l}
	~/.config/bspwm/scripts/smart_send.sh {west,south,north,east}

# focus prev / next desktop
# stays on the current monitor
super + bracket{left,right}
	bspc desktop -f {prev,next}.local

# move window to prev / next desktop, follow
super + shift + bracket{left,right}
    bspc node -d {prev,next}.local --follow

# move window to prev / next desktop
super + ctrl + bracket{left,right}
    bspc node -d {prev,next}.local

# focus desktop n
# desktops are numbered per monitor
super + {1-9,0}
	bspc desktop focused:^{1-9,10} -f

# move window to desktop n, follow
super + shift + {1-9,0}
	bspc node -d focused:^{1-9,10} --follow

# transplant window in direction
# bspc node -n: inserts beside the neighbour, honouring its preselection
super + ctrl + {h,j,k,l}
	bspc node -n {west,south,north,east}

# move window to desktop n
super + ctrl + {1-9,0}
	bspc node -d focused:^{1-9,10}

# focus last window / desktop
super + {Tab, grave}
	bspc {node,desktop} -f last

# focus next / prev window
super + {_,shift + }c
	bspc node -f {next,prev}.local.!hidden.window

# cycle windows
# useful in monocle layout
super + {comma,period}
	bspc node -f {prev,next}.local.!hidden.window

# focus older / newer in history
super + {o,i}
	bspc wm -h off; \
	bspc node {older,newer} -f; \
	bspc wm -h on

# TODO: Figure out what these do

# focus the node for the given path jump
# super + {p,b,comma,period}
# 	bspc node -f @{parent,brother,first,second}

###############
## preselect ##
###############

# preselect split direction
super + alt + {h,j,k,l}
	bspc node -p {west,south,north,east}

# preselect split ratio
super + alt + {1-9}
	bspc node -o 0.{1-9}

# cancel preselection
super + alt + space
	bspc node -p cancel

# cancel all preselections on desktop
super + alt + shift + space
	bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

#################
## move/resize ##
#################

# resize window
# grows toward a neighbour, or shrinks from the opposite side at the edge
super + {Left,Down,Up,Right}
	~/.config/bspwm/scripts/smart_resize.sh {west,south,north,east}

# move a floating window
super + shift + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}

############################
## wm independent hotkeys ##
############################

# volume up
XF86AudioRaiseVolume
    pactl set-sink-volume @DEFAULT_SINK@ +5%

# volume down
XF86AudioLowerVolume
    pactl set-sink-volume @DEFAULT_SINK@ -5%

# toggle mute
XF86AudioMute
    pactl set-sink-mute @DEFAULT_SINK@ toggle

# brightness up
XF86MonBrightnessUp
    brightnessctl set +1%

# brightness down
XF86MonBrightnessDown
    brightnessctl set 1%-

# brightness up (large step)
shift + XF86MonBrightnessUp
    brightnessctl set +10%

# brightness down (large step)
shift + XF86MonBrightnessDown
    brightnessctl set 10%-

# screenshot region
# saved to ~/Pictures/Screenshots and copied to the clipboard
Print
    mkdir -p ~/Pictures/Screenshots && scrot -s ~/Pictures/Screenshots/'%Y-%m-%d_%H%M%S_region.png' -e 'xclip -selection clipboard -t image/png -i "$f"'

# screenshot full screen
# saved to ~/Pictures/Screenshots and copied to the clipboard
super + Print
    mkdir -p ~/Pictures/Screenshots && scrot ~/Pictures/Screenshots/'%Y-%m-%d_%H%M%S_full.png' -e 'xclip -selection clipboard -t image/png -i "$f"'

# screenshot each display, joined
# scrot -m; saved to ~/Pictures/Screenshots and copied to the clipboard
super + shift + Print
    mkdir -p ~/Pictures/Screenshots && scrot -m ~/Pictures/Screenshots/'%Y-%m-%d_%H%M%S_all.png' -e 'xclip -selection clipboard -t image/png -i "$f"'

# terminal
super + Return
	~/.config/kitty/launch.sh

# local terminal
# always local, ignores a kitten ssh session in the focused window
super + shift + Return
	~/.config/kitty/launch.sh --home

# app launcher
super + @space
	rofi -no-config -no-lazy-grab -show drun -modi drun -theme ~/.config/polybar/shades/scripts/rofi/launcher.rasi

# window switcher
alt + Tab
	rofi -no-config -no-lazy-grab -show window -modi window -theme ~/.config/polybar/shades/scripts/rofi/launcher.rasi

# power menu
super + BackSpace
	~/.config/polybar/shades/scripts/powermenu.sh


# restart polybar
# re-applies the current profile via the reconciliation pipeline
super + alt + shift + p
  ~/.config/bspwm/scripts/apply-auto.sh

# screen recorder
super + shift + p
  python3 ~/.config/bspwm/scripts/screen-recorder.py

# toggle polybar visibility
super + alt + p
  ~/.config/bspwm/scripts/toggle_polybar.sh

# screenshot full screen
# same as super+Print, for keyboards without a Print key
super + p
  mkdir -p ~/Pictures/Screenshots && scrot ~/Pictures/Screenshots/'%Y-%m-%d_%H%M%S_full.png' -e 'xclip -selection clipboard -t image/png -i "$f"'

# lock screen
super + alt + ctrl + l
    ~/.local/bin/lockscreen

# lock and suspend
# i3lock forks, so wait a beat before suspending
super + shift + s
    ~/.local/bin/lockscreen; sleep 1; systemctl suspend

# toggle redshift
super + shift + r
    pkill -x redshift || redshift -c ~/.config/redshift.conf &

# clear notifications
super + shift + d
  dunstctl close-all

# pick monitor profile
# interactive monitor-manager selection
super + shift + x
  ~/.config/bspwm/scripts/monitor-switch.sh

# force laptop screen on (emergency)
# works blind: enables any connected eDP-* output
super + shift + F1
  xrandr --query | grep -o '^eDP[^ ]* connected' | cut -d' ' -f1 | \
  xargs -r -n1 -I OUT xrandr --output OUT --auto; \
  notify-send "Display Recovery" "Laptop screen enabled"

# toggle caps / escape swap
# Toggles caps:swapescape via systemd user service. Bound to both keysyms
# because the swap itself changes which one the physical key emits.
super + shift + {Caps_Lock,Escape}
  systemctl --user is-active --quiet swapescape.service \
    && systemctl --user stop swapescape.service \
    || systemctl --user start swapescape.service

# hotkey cheatsheet
# parsed live from this file; see the note at the top
super + slash
  ~/.config/bspwm/scripts/hotkeys.sh
