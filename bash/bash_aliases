#!/bin/bash

# ======================
# >>> misc functions <<<
# ======================
rg() {
  command rg -p "$@" | less -RFX
}
# >>> misc functions end

# ============
# >>> tmux <<<
# ============
tmat() {
  if [ "$#" -eq 1 ]; then
    tmux a -t "$1"
  else
    echo "Usage: tmat <session-name>"
  fi
}

tmns() {
  if [ "$#" -eq 1 ]; then
    tmux new -s "$1"
  else
    echo "Usage: tmns <session-name>"
  fi
}

tmks() {
  if [ "$#" -eq 1 ]; then
    tmux kill-session -t "$1"
  else
    tmux kill-server
  fi
}

tmls() {
  tmux ls
}
# >>> tmux end

